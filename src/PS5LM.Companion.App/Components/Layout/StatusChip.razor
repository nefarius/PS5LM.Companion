@if (Console is { } console)
{
    var lifecycle = console.Store.Current.Lifecycle;
    <MudChip T="string" Color="@Display.LifecycleColor(lifecycle)" Variant="Variant.Filled" Class="mr-3"
             aria-label="@($"{console.Name}, {console.Host}, {Display.Lifecycle(lifecycle)}")">
        @console.Name · @console.Host
    </MudChip>
}

@code {
    [Parameter]
    public ConsoleRuntime? Console { get; set; }
}
