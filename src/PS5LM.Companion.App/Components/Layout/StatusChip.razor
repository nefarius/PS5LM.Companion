@if (Console is { } console)
{
    var status = console.Store.Current;
    <MudChip T="string" Color="@Display.ConsoleStateColor(status)" Variant="Variant.Filled" Class="mr-3"
             aria-label="@($"{console.Name}, {console.Host}, {Display.ConsoleState(status)}")">
        @console.Name · @console.Host
    </MudChip>
}

@code {
    [Parameter]
    public ConsoleRuntime? Console { get; set; }
}
