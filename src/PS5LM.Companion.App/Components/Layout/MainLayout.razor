@inherits LayoutComponentBase
@implements IDisposable
@using System.Text.Json
@using Microsoft.JSInterop
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IConsoleRegistry Registry
@inject TransferService Transfers
@inject LatestReleaseChecker VersionChecker
@inject ISnackbar Snackbar

<MudThemeProvider @bind-IsDarkMode="_dark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" aria-label="Toggle navigation menu" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        <a href="/" class="app-brand">
            <img src="@Assets["logo.svg"]" width="28" height="28" alt="" />
            <MudText Typo="Typo.h6">PS5LM Companion</MudText>
        </a>
        <MudSpacer />
        <StatusChip Console="@_current" />
        <MudTooltip Text="@_versionStatus.Tooltip">
            <MudChip T="string"
                     Size="Size.Small"
                     Variant="Variant.Outlined"
                     Color="@(_versionStatus.UpdateAvailable ? Color.Warning : Color.Default)"
                     Class="app-version"
                     aria-label="@_versionStatus.AriaLabel"
                     Href="@_versionStatus.ReleaseUri?.ToString()"
                     Target="@(_versionStatus.ReleaseUri is null ? null : "_blank")"
                     Rel="@(_versionStatus.ReleaseUri is null ? null : "noopener noreferrer")">@_versionStatus.ChipLabel</MudChip>
        </MudTooltip>
        <MudTooltip Text="Check for updates now">
            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Size="Size.Small"
                           Color="Color.Inherit"
                           Class="app-version-check"
                           aria-label="Check for updates now"
                           Disabled="@_checkingVersion"
                           OnClick="CheckForUpdatesAsync" />
        </MudTooltip>
        <MudIconButton Href="https://github.com/nefarius/PS5LM.Companion/"
                       Target="_blank"
                       Rel="noopener noreferrer"
                       Icon="@Icons.Custom.Brands.GitHub"
                       Color="Color.Inherit"
                       aria-label="PS5LM Companion on GitHub"
                       title="PS5LM Companion on GitHub" />
        <MudIconButton Icon="@(_dark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" aria-label="@(_dark ? "Switch to light theme" : "Switch to dark theme")"
                       OnClick="@(() => _dark = !_dark)" />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="2">
        <MudNavMenu>
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Overview</MudNavLink>
            <MudNavLink Href="inference" Icon="@Icons.Material.Filled.AltRoute">Inference</MudNavLink>
            <MudMenu ActivationEvent="@MouseEvent.RightClick" PositionAtCursor="true" Class="d-block" Dense="true">
                <ActivatorContent>
                    <div class="d-block" @oncontextmenu="context.ToggleAsync" @oncontextmenu:preventDefault="true">
                        <MudNavLink Href="settings/consoles" Icon="@Icons.Material.Filled.Settings">Manage consoles</MudNavLink>
                    </div>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Icon="@Icons.Material.Filled.UnfoldMore" OnClick="@(() => SetAllOpen(true))" Disabled="@(!Registry.All.Any())">Expand all consoles</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.UnfoldLess" OnClick="@(() => SetAllOpen(false))" Disabled="@(!Registry.All.Any())">Collapse all consoles</MudMenuItem>
                </ChildContent>
            </MudMenu>
            @foreach (var console in Registry.All)
            {
                var status = console.Store.Current;
                var modelLabel = Display.ModelActivity(status);
                var (running, queued) = Display.TransferActivity(Transfers.Snapshot(console.Id));
                var downloadLabel = Display.TransferActivityLabel(running, queued);
                <MudNavGroup Title="@console.Name"
                             @bind-Expanded:get="@IsOpen(console.Id)"
                             @bind-Expanded:set="@(open => SetOpen(console.Id, open))">
                    <TitleContent>
                        <span class="nav-activity-row">
                            <LifecycleDot Lifecycle="@status.Lifecycle" />
                            <MudText Typo="Typo.body1">@console.Name</MudText>
                            @if (!IsOpen(console.Id))
                            {
                                <NavActivity Busy="@(modelLabel is not null || running)" Pending="@(downloadLabel is not null)"
                                             Label="@GroupActivityLabel(modelLabel, downloadLabel)" />
                            }
                        </span>
                    </TitleContent>
                    <ChildContent>
                        <MudNavLink Href="@($"consoles/{console.Id}")" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Status</MudNavLink>
                        <MudNavLink Href="@($"consoles/{console.Id}/models")" Icon="@Icons.Material.Filled.Memory">
                            <span class="nav-activity-row">
                                Models
                                <NavActivity Busy="@(modelLabel is not null)" Label="@modelLabel" />
                            </span>
                        </MudNavLink>
                        <MudNavLink Href="@($"consoles/{console.Id}/downloads")" Icon="@Icons.Material.Filled.CloudDownload">
                            <span class="nav-activity-row">
                                Downloads
                                <NavActivity Busy="@running" Pending="@(downloadLabel is not null)" Label="@downloadLabel" />
                            </span>
                        </MudNavLink>
                    </ChildContent>
                </MudNavGroup>
            }
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error occurred.
    <a href=".">Reload</a>
</div>

@code {
    private const string NavOpenStorageKey = "ps5lm.nav.open";

    private readonly Dictionary<string, bool> _open = new(StringComparer.Ordinal);
    private readonly HashSet<string> _chosen = new(StringComparer.Ordinal);

    // Last seen transfer activity per console, so progress ticks do not re-render the drawer.
    private readonly Dictionary<string, (bool Running, int Queued)> _transfers = new(StringComparer.Ordinal);
    private VersionCheckStatus _versionStatus = new(null, null, false, null);
    private ConsoleRuntime? _current;
    private bool _drawerOpen = true;
    private bool _dark = true;
    private bool _versionCheckStarted;
    private bool _checkingVersion;
    private bool _navOpenReady;

    protected override void OnInitialized()
    {
        _versionStatus = VersionChecker.GetLocalStatus();
        Navigation.LocationChanged += OnLocationChanged;
        Registry.Changed += OnRegistryChanged;
        Transfers.Changed += OnTransfersChanged;
        foreach (var console in Registry.All)
        {
            _open[console.Id] = false;
            console.Store.Changed += OnStatusChanged;
        }

        RefreshCurrent();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RestoreNavOpenAsync();
        }

        if (!firstRender || _versionCheckStarted)
        {
            return;
        }

        _versionCheckStarted = true;
        try
        {
            _versionStatus = await VersionChecker.GetStatusAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // The local version chip remains visible when the latest-release lookup fails.
        }
    }

    private async Task CheckForUpdatesAsync()
    {
        if (_checkingVersion)
        {
            return;
        }

        _checkingVersion = true;
        try
        {
            _versionStatus = await VersionChecker.RefreshAsync();
            if (_versionStatus.UpdateAvailable && !string.IsNullOrWhiteSpace(_versionStatus.LatestVersion))
            {
                Snackbar.Add($"Version {DisplayVersion(_versionStatus.LatestVersion)} is available.", Severity.Warning);
            }
            else if (_versionStatus.CheckFailed)
            {
                Snackbar.Add("Could not check for updates.", Severity.Error);
            }
            else if (!_versionStatus.HasLocalVersion)
            {
                Snackbar.Add("The running version could not be determined.", Severity.Warning);
            }
            else
            {
                Snackbar.Add("You are running the latest version.", Severity.Success);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Could not check for updates.", Severity.Error);
        }
        finally
        {
            _checkingVersion = false;
        }
    }

    private static string DisplayVersion(string version)
    {
        var trimmed = version.Trim();
        return trimmed[0] is 'v' or 'V' ? trimmed : "v" + trimmed;
    }

    private void OnRegistryChanged(ConsoleChange change)
    {
        if (change.Previous is { } previous)
        {
            previous.Store.Changed -= OnStatusChanged;
        }

        if (change.Current is { } current)
        {
            current.Store.Changed += OnStatusChanged;
            if (change.IsRename && change.Previous is { } from && _open.Remove(from.Id, out var open))
            {
                _open[current.Id] = open;
                if (_chosen.Remove(from.Id))
                {
                    _chosen.Add(current.Id);
                }
            }
            else
            {
                _open.TryAdd(current.Id, false);
            }
        }
        else if (change.Previous is { } removed)
        {
            _open.Remove(removed.Id);
            _chosen.Remove(removed.Id);
        }

        RememberNavOpen();

        RefreshCurrent();
        try
        {
            _ = InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // The circuit ended.
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        RefreshCurrent();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnTransfersChanged()
    {
        try
        {
            // The comparison writes the cache, so it has to run on the renderer thread with the render it gates.
            _ = InvokeAsync(() =>
            {
                if (TransferActivityChanged())
                {
                    StateHasChanged();
                }
            });
        }
        catch (ObjectDisposedException)
        {
            // The circuit ended.
        }
    }

    /// <summary>Updates the transfer cache and reports whether any console's indicator would change.</summary>
    private bool TransferActivityChanged()
    {
        var changed = false;
        var seen = new HashSet<string>(StringComparer.Ordinal);
        foreach (var console in Registry.All)
        {
            seen.Add(console.Id);
            var activity = Display.TransferActivity(Transfers.Snapshot(console.Id));
            if (!_transfers.TryGetValue(console.Id, out var previous) || previous != activity)
            {
                _transfers[console.Id] = activity;
                changed = true;
            }
        }

        foreach (var id in _transfers.Keys.Where(id => !seen.Contains(id)).ToList())
        {
            _transfers.Remove(id);
            changed = true;
        }

        return changed;
    }

    private static string GroupActivityLabel(string? modelLabel, string? downloadLabel) =>
        modelLabel is null ? downloadLabel ?? "" :
        downloadLabel is null ? modelLabel : $"{modelLabel}, {downloadLabel.ToLowerInvariant()}";

    private void OnStatusChanged(CompanionStatus status)
    {
        try
        {
            _ = InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // The circuit ended.
        }
    }

    private void RefreshCurrent()
    {
        _current = FindFromUri();
        if (_current is not null && _navOpenReady && !_chosen.Contains(_current.Id))
        {
            _open[_current.Id] = true;
        }
    }

    private ConsoleRuntime? FindFromUri()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var cut = relative.IndexOfAny(['?', '#']);
        if (cut >= 0)
        {
            relative = relative[..cut];
        }

        const string prefix = "consoles/";
        if (!relative.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }

        var rest = relative[prefix.Length..];
        var slash = rest.IndexOf('/');
        var id = slash < 0 ? rest : rest[..slash];
        return id.Length == 0 ? null : Registry.Find(id);
    }

    private bool IsOpen(string id) => _open.TryGetValue(id, out var open) && open;

    private void SetOpen(string id, bool open)
    {
        _open[id] = open;
        _chosen.Add(id);
        RememberNavOpen();
    }

    private void SetAllOpen(bool open)
    {
        foreach (var console in Registry.All)
        {
            _open[console.Id] = open;
            _chosen.Add(console.Id);
        }

        RememberNavOpen();
    }

    private async Task RestoreNavOpenAsync()
    {
        var storedCurrent = false;
        var pendingChoice = false;
        try
        {
            var json = await JS.InvokeAsync<string?>("sessionStorage.getItem", NavOpenStorageKey);
            // A toggle during the read is already in _chosen and must win over the stored value.
            pendingChoice = _chosen.Count > 0;
            if (!string.IsNullOrWhiteSpace(json))
            {
                var stored = JsonSerializer.Deserialize<Dictionary<string, bool>>(json);
                if (stored is not null)
                {
                    foreach (var (id, open) in stored)
                    {
                        if (Registry.Find(id) is not { } console || _chosen.Contains(console.Id))
                        {
                            continue;
                        }

                        _open[console.Id] = open;
                        _chosen.Add(console.Id);
                        if (_current is not null && string.Equals(console.Id, _current.Id, StringComparison.OrdinalIgnoreCase))
                        {
                            storedCurrent = true;
                        }
                    }
                }
            }
        }
        catch (Exception)
        {
            // Session storage is unavailable while the circuit is starting or already gone.
            pendingChoice = _chosen.Count > 0;
        }

        // A console page opens its group until the user has stored a choice for it.
        if (_current is not null && !storedCurrent && !_chosen.Contains(_current.Id))
        {
            _open[_current.Id] = true;
        }

        _navOpenReady = true;
        if (pendingChoice)
        {
            RememberNavOpen();
        }

        await InvokeAsync(StateHasChanged);
    }

    private void RememberNavOpen()
    {
        if (!_navOpenReady)
        {
            return;
        }

        _ = PersistNavOpenAsync();
    }

    private async Task PersistNavOpenAsync()
    {
        try
        {
            var snapshot = new Dictionary<string, bool>(StringComparer.Ordinal);
            foreach (var console in Registry.All)
            {
                if (_chosen.Contains(console.Id))
                {
                    snapshot[console.Id] = IsOpen(console.Id);
                }
            }
            await JS.InvokeVoidAsync("sessionStorage.setItem", NavOpenStorageKey, JsonSerializer.Serialize(snapshot));
        }
        catch (Exception)
        {
            // The in-memory state still applies for this circuit.
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Registry.Changed -= OnRegistryChanged;
        Transfers.Changed -= OnTransfersChanged;
        foreach (var console in Registry.All)
        {
            console.Store.Changed -= OnStatusChanged;
        }
    }
}
