@inherits LayoutComponentBase
@inject ActiveConsole Active

<MudThemeProvider @bind-IsDarkMode="_dark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" aria-label="Toggle navigation menu" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        <MudText Typo="Typo.h6" Class="ml-2">PS5LM Companion</MudText>
        <MudSpacer />
        @if (Active.All.Count > 1)
        {
            <MudSelect T="string" Value="@Active.Runtime.Id" ValueChanged="@(id => Active.Select(id))"
                       Label="Console" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                       Class="mr-3" Style="max-width:16rem" aria-label="Console">
                @foreach (var console in Active.All)
                {
                    <MudSelectItem T="string" Value="@console.Id">@console.Name</MudSelectItem>
                }
            </MudSelect>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mr-3">@Active.Runtime.Name</MudText>
        }
        <StatusChip />
        <MudIconButton Icon="@(_dark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" aria-label="@(_dark ? "Switch to light theme" : "Switch to dark theme")"
                       OnClick="@(() => _dark = !_dark)" />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="2">
        <MudNavMenu>
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Status</MudNavLink>
            <MudNavLink Href="models" Icon="@Icons.Material.Filled.Memory">Models</MudNavLink>
            <MudNavLink Href="transfers" Icon="@Icons.Material.Filled.CloudDownload">Downloads</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error occurred.
    <a href=".">Reload</a>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _dark = true;
}
