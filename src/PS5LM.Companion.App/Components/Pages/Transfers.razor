@page "/consoles/{ConsoleId}/downloads"
@using PS5LM.Companion.Core.Models.Planning
@inherits LiveComponent
@inject IModelHub Hub
@inject HubFitService Fits
@inject ISnackbar Snackbar
@inject TimeProvider Time

<AppPageTitle Page='@(Target is null ? "Console not found" : $"Downloads - {Target.Name}")' />

@if (Target is null)
{
    <ConsoleNotFound />
}
else
{
<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-2">Downloads<MudText Typo="Typo.subtitle1" Color="Color.Secondary" Inline="true" Class="ml-3">to @Target.Name (@Target.Host)</MudText></MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-2">Find a model on Hugging Face</MudText>
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudTextField @bind-Value="_query" Label="Search GGUF repositories" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Immediate="true" OnKeyDown="OnSearchKey" Style="max-width:32rem" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SearchAsync" Disabled="@SearchBlocked">
            @if (_searching)
            {
                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                @:Searching...
            }
            else
            {
                @:Search
            }
        </MudButton>
        <MudSwitch T="bool" @bind-Value="_hideTooBig" Color="Color.Primary" Label="Hide models that are too big" />
        @if (_targets.Count > 1)
        {
            <MudSelect T="string" @bind-Value="_target" Label="Upload to" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:14rem">
                @foreach (var target in _targets)
                {
                    <MudSelectItem Value="@target">@target</MudSelectItem>
                }
            </MudSelect>
        }
    </MudStack>

    @if (_searching || _loadingRepo is not null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-3" />
    }

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
    }
    else if (NoMatches)
    {
        <MudAlert Severity="Severity.Info" Class="mt-3">No GGUF repositories match "@_searchedFor".</MudAlert>
    }

    @if (VisibleRepos.Any())
    {
        <MudList T="HubRepo" Class="mt-2" Style="max-height:16rem;overflow:auto" Disabled="@(_searching || _loadingRepo is not null)" SelectedValueChanged="OnRepoSelected">
            @foreach (var repo in VisibleRepos)
            {
                <MudListItem T="HubRepo" Value="@repo">
                    <div class="d-flex align-center" style="gap:0.5rem">
                        <span>@repo.Id</span>
                        @if (Hint(repo) is { } hint)
                        {
                            <MudTooltip Text="@hint.Detail">
                                <MudChip T="string" Size="Size.Small" Color="@HintColor(hint.Kind)">@hint.Label</MudChip>
                            </MudTooltip>
                        }
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@($"{repo.Downloads:N0} downloads")</MudText>
                </MudListItem>
            }
        </MudList>
    }
    @if (HiddenTooBigRepos > 0)
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">@HiddenReposCaption</MudText>
    }

    @if (_loadingRepo is not null)
    {
        <MudText Typo="Typo.body2" Class="mt-3">Loading files of @_loadingRepo...</MudText>
    }
    else if (_files is not null)
    {
        <MudText Typo="Typo.subtitle1" Class="mt-3">@_selectedRepo</MudText>
        <MudSimpleTable Dense="true" Hover="true">
            <thead><tr><th>File</th><th>Size</th><th>Fit on PS5</th><th></th></tr></thead>
            <tbody>
                @foreach (var file in _files.Where(f => f.IsLoadableModel && ShowFile(f)))
                {
                    <tr>
                        <td>@file.Name</td>
                        <td>@Display.Bytes(file.SizeBytes)</td>
                        <td>
                            @if (FitOf(file) is { } fit)
                            {
                                @if (fit.Kind != HubFitKind.NotApplicable)
                                {
                                    <MudTooltip Text="@fit.Detail">
                                        <MudChip T="string" Size="Size.Small" Color="@FitColor(fit.Kind)">@fit.Label</MudChip>
                                    </MudTooltip>
                                }
                            }
                            else
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            }
                        </td>
                        <td><MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download"
                                       OnClick="@(() => EnqueueAsync(file))" Disabled="@_enqueuing.Contains(file.Name)">Download to console</MudButton></td>
                    </tr>
                }
                @if (_files.Count(f => f.IsLoadableModel) == 0)
                {
                    <tr><td colspan="4">This repository has no top-level model .gguf files.</td></tr>
                }
            </tbody>
        </MudSimpleTable>
        @if (_files.Count(f => !f.IsLoadableModel) is > 0 and var hidden)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">@hidden vision projector or imatrix @(hidden == 1 ? "file is" : "files are") not listed: they cannot be loaded on their own.</MudText>
        }
        @if (_budget is { } budget)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">Fit uses @budget.Caption. It follows the app's planner and does not check whether this llama.cpp build knows the architecture. Downloading stays available either way.</MudText>
        }
    }
</MudPaper>

<MudPaper Elevation="1">
    <MudTable Items="Transfers.Snapshot(Target.Id)" Dense="true" Hover="true" T="Transfer">
        <ToolBarContent><MudText Typo="Typo.h6">Transfers</MudText></ToolBarContent>
        <HeaderContent>
            <MudTh>File</MudTh>
            <MudTh>State</MudTh>
            <MudTh Style="min-width:12rem">Progress</MudTh>
            <MudTh>Target</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="File">
                @context.FileName<br />
                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Repo · @Display.Bytes(context.SizeBytes)</MudText>
            </MudTd>
            <MudTd DataLabel="State">
                <MudChip T="string" Size="Size.Small" Color="@Display.TransferColor(context.State)">@context.State</MudChip>
                @if (context.Error is not null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error">@context.Error</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Progress">
                @if (context.IsActive)
                {
                    <MudProgressLinear Value="@Display.Progress(context)" Color="Color.Info" />
                }
                else if (context.State == TransferState.Completed)
                {
                    <MudProgressLinear Value="100" Color="Color.Success" />
                }
            </MudTd>
            <MudTd DataLabel="Target">@context.TargetRoot</MudTd>
            <MudTd>
                @if (context.IsActive)
                {
                    <MudButton Size="Size.Small" Color="Color.Warning" OnClick="@(() => CancelAsync(context))">Cancel</MudButton>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="pa-4" Color="Color.Secondary">No transfers yet.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>
}

@code {
    private string _query = string.Empty;
    private string? _target;
    private string? _error;
    private string? _selectedRepo;
    private string? _searchedFor;
    private string? _loadingRepo;
    private bool _searching;
    private bool _hideTooBig;
    private int _requestVersion;
    private readonly HashSet<string> _enqueuing = [];
    private IReadOnlyList<string> _targets = [];
    private IReadOnlyList<HubRepo> _repos = [];
    private IReadOnlyList<HubFile>? _files;
    private Dictionary<string, HubFileFit> _fits = new(StringComparer.Ordinal);
    private ModelBudget? _budget;
    private ModelBudget? _fitBudget;

    private string? _targetsFor;
    private string? _loadingKey;
    private string? _budgetFor;
    private string? _budgetLoading;
    private DateTimeOffset _budgetReadAt;
    private CancellationTokenSource? _fitsCancel;

    /// <summary>
    /// How often a live update may reread <c>app.log</c>. Status and transfer progress arrive much more often.
    /// </summary>
    internal static readonly TimeSpan BudgetRefreshInterval = TimeSpan.FromSeconds(30);

    protected override Task OnConsoleChangedAsync()
    {
        _query = string.Empty;
        _hideTooBig = false;
        _error = null;
        _selectedRepo = null;
        _searchedFor = null;
        _loadingRepo = null;
        _searching = false;
        _repos = [];
        _files = null;
        _fits = new(StringComparer.Ordinal);
        _budget = null;
        _fitBudget = null;
        _budgetFor = null;
        _budgetReadAt = default;
        _requestVersion++;
        _enqueuing.Clear();
        CancelFits();
        ClearTargets();
        return RefreshConsoleAsync();
    }

    protected override void OnDisposed()
    {
        CancelFits();
        _fitsCancel?.Dispose();
        _fitsCancel = null;
    }

    // The console (or its state folder) can appear after this page opened.
    protected override Task OnLiveChangeAsync() => Target is null ? Task.CompletedTask : RefreshConsoleAsync();

    private Task RefreshConsoleAsync() => Task.WhenAll(RefreshTargetsAsync(), RefreshBudgetAsync());

    private string? CurrentTargetsKey() =>
        Target?.Status.LastInstallation?.StateRoot is { } root ? $"{Target.Id}:{root.FtpPath}" : null;

    private async Task RefreshTargetsAsync()
    {
        var console = Target;
        if (console is null)
        {
            ClearTargets();
            return;
        }

        var installation = console.Status.LastInstallation;
        var key = CurrentTargetsKey();
        if (key is null || installation is null)
        {
            // This console has no usable state folder (yet): drop anything loaded for another one.
            ClearTargets();
            return;
        }

        if (key == _targetsFor)
        {
            return;
        }

        if (_targetsFor is not null)
        {
            // Never offer another console's targets while this one's are loading.
            ClearTargets();
        }

        if (_loadingKey == key)
        {
            return;
        }

        _loadingKey = key;
        var stale = false;
        try
        {
            var targets = (await console.Models.UploadTargetsAsync(installation, CancellationToken.None)).Select(t => t.Name).ToList();
            if (CurrentTargetsKey() != key)
            {
                stale = true;
            }
            else
            {
                _targets = targets;
                _targetsFor = key;
                if (_target is null || !targets.Contains(_target))
                {
                    _target = targets.FirstOrDefault();
                }
            }
        }
        catch (Core.Abstractions.ConsoleUnreachableException)
        {
            // The status page already says the console is unreachable.
            stale = CurrentTargetsKey() != key;
        }
        finally
        {
            if (_loadingKey == key)
            {
                _loadingKey = null;
            }
        }

        if (stale)
        {
            await RefreshTargetsAsync();
        }
    }

    private void ClearTargets()
    {
        _targets = [];
        _targetsFor = null;
        _target = null;
    }

    private async Task RefreshBudgetAsync()
    {
        var console = Target;
        var key = console is null ? null : CurrentTargetsKey() ?? $"{console.Id}:none";
        if (console is null || key is null)
        {
            _budget = null;
            _budgetFor = null;
            _budgetReadAt = default;
            return;
        }

        // Progress wakes this page many times a second. The same console is reread on the interval above.
        if (_budgetLoading == key || (key == _budgetFor && Time.GetUtcNow() - _budgetReadAt < BudgetRefreshInterval))
        {
            return;
        }

        _budgetLoading = key;
        ModelBudget budget;
        try
        {
            budget = await Fits.ReadBudgetAsync(console.FileSystem, console.Status.LastInstallation?.StateRoot, CancellationToken.None);
        }
        catch (Core.Abstractions.ConsoleUnreachableException)
        {
            budget = Fits.AssumedBudget;
        }
        finally
        {
            if (_budgetLoading == key)
            {
                _budgetLoading = null;
            }
        }

        var current = Target;
        var currentKey = current is null ? null : CurrentTargetsKey() ?? $"{current.Id}:none";
        if (currentKey != key)
        {
            return;
        }

        _budget = budget;
        _budgetFor = key;
        _budgetReadAt = Time.GetUtcNow();
        if (_files is not null && _selectedRepo is not null && _fitBudget is { } used && !SameBudget(used, budget))
        {
            _ = ShowFitsAsync(_requestVersion, _selectedRepo, _files);
        }
    }

    private static bool SameBudget(ModelBudget left, ModelBudget right) =>
        left.FromAppLog == right.FromAppLog && left.CtxCap == right.CtxCap && left.KvType == right.KvType && left.Gib == right.Gib;

    private bool SearchBlocked => _searching || _loadingRepo is not null || string.IsNullOrWhiteSpace(_query);

    private bool NoMatches => _searchedFor is not null && !_searching && _repos.Count == 0;

    private async Task OnSearchKey(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !SearchBlocked)
        {
            await SearchAsync();
        }
    }

    private Task SearchAsync() => GuardHubAsync(
        searching: true,
        loadingRepo: null,
        action: async version =>
        {
            _files = null;
            _selectedRepo = null;
            _fits = new(StringComparer.Ordinal);
            CancelFits();
            var query = _query;
            var repos = await Hub.SearchAsync(query, CancellationToken.None);
            if (version == _requestVersion)
            {
                _repos = repos;
                _searchedFor = query;
            }
        });

    private Task OnRepoSelected(HubRepo? repo) => repo is null
        ? Task.CompletedTask
        : GuardHubAsync(
            searching: false,
            loadingRepo: repo.Id,
            action: async version =>
            {
                // The repository and its file list are committed together, and only for the latest request.
                _files = null;
                _selectedRepo = null;
                _fits = new(StringComparer.Ordinal);
                CancelFits();
                var files = await Hub.ListFilesAsync(repo.Id, CancellationToken.None);
                if (version == _requestVersion)
                {
                    _selectedRepo = repo.Id;
                    _files = files;
                    _ = ShowFitsAsync(version, repo.Id, files);
                }
            });

    /// <summary>Latest request wins: results and errors of a superseded request are dropped.</summary>
    private async Task GuardHubAsync(bool searching, string? loadingRepo, Func<int, Task> action)
    {
        var version = ++_requestVersion;
        _searching = searching;
        _loadingRepo = loadingRepo;
        _error = null;
        try
        {
            await action(version);
        }
        catch (HubUnavailableException ex) when (version == _requestVersion)
        {
            _error = ex.Message;
        }
        catch (HubUnavailableException)
        {
            // Superseded by a newer request.
        }
        finally
        {
            if (version == _requestVersion)
            {
                _searching = false;
                _loadingRepo = null;
            }
        }
    }

    private async Task EnqueueAsync(HubFile file)
    {
        var repo = _selectedRepo;
        var console = Target;
        if (repo is null || console is null || !_enqueuing.Add(file.Name))
        {
            return;
        }

        OperationResult result;
        try
        {
            (result, _) = await Transfers.EnqueueAsync(new TransferRequest(console.Id, repo, file.Name, _target), CancellationToken.None);
        }
        catch (Exception ex) when (ex is Core.Abstractions.ConsoleUnreachableException or HubUnavailableException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return;
        }
        finally
        {
            _enqueuing.Remove(file.Name);
        }

        Snackbar.Add(result.Succeeded ? $"Queued {file.Name}" : result.Message ?? result.Outcome.ToString(), result.Succeeded ? Severity.Success : Severity.Error);
    }

    private async Task CancelAsync(Transfer transfer) => await Transfers.CancelAsync(transfer.Id, CancellationToken.None);

    private RepoFit? Hint(HubRepo repo) => _budget is null ? null : RepoFit.Estimate(repo.Parameters, repo.Architecture, _budget.Gib);

    private IEnumerable<HubRepo> VisibleRepos => _hideTooBig
        ? _repos.Where(repo => Hint(repo)?.Kind != RepoFitKind.TooBig)
        : _repos;

    private int HiddenTooBigRepos => _hideTooBig ? _repos.Count(repo => Hint(repo)?.Kind == RepoFitKind.TooBig) : 0;

    private string HiddenReposCaption
    {
        get
        {
            var noun = HiddenTooBigRepos == 1 ? "repository" : "repositories";
            return $"{HiddenTooBigRepos} {noun} hidden as too big for {ModelBudget.OneDecimal(_budget!.Gib)} GiB.";
        }
    }

    private bool ShowFile(HubFile file) => !_hideTooBig || FitOf(file)?.Kind != HubFitKind.TooBig;

    private HubFileFit? FitOf(HubFile file) => _fits.TryGetValue(file.Name, out var fit) ? fit : null;

    private static Color HintColor(RepoFitKind kind) => kind switch
    {
        RepoFitKind.LikelyFits => Color.Success,
        RepoFitKind.LowBitOnly => Color.Warning,
        _ => Color.Error,
    };

    private static Color FitColor(HubFitKind kind) => kind switch
    {
        HubFitKind.Fits => Color.Success,
        HubFitKind.TooBig => Color.Error,
        _ => Color.Default,
    };

    private void CancelFits()
    {
        var running = _fitsCancel;
        _fitsCancel = null;
        if (running is null)
        {
            return;
        }

        running.Cancel();
        running.Dispose();
    }

    private async Task ShowFitsAsync(int version, string repo, IReadOnlyList<HubFile> files)
    {
        _fitsCancel?.Cancel();
        _fitsCancel?.Dispose();
        _fitsCancel = new CancellationTokenSource();
        var token = _fitsCancel.Token;
        _fits = new Dictionary<string, HubFileFit>(StringComparer.Ordinal);
        var budget = _budget ?? Fits.AssumedBudget;
        _fitBudget = budget;
        try
        {
            await foreach (var fit in Fits.CheckAsync(repo, files, budget, token))
            {
                if (version != _requestVersion)
                {
                    break;
                }

                _fits[fit.Name] = fit;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // A newer search or another repository replaced this check.
        }
        catch (Exception ex) when (version == _requestVersion)
        {
            _error = ex.Message;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // Superseded by a newer request.
        }
    }
}
