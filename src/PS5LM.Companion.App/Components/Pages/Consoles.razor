@page "/settings/consoles"
@implements IDisposable
@inject IConsoleRegistry Registry
@inject TransferService Transfers
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<AppPageTitle Page="Consoles" />

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4" HtmlTag="h1">Consoles</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Wifi" OnClick="ScanAsync">Scan network</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync">Add console</MudButton>
</MudStack>

<MudText Class="mb-3" Color="Color.Secondary">
    Consoles from configuration are read-only. Consoles added here are stored in the data directory and apply without a restart.
</MudText>

@if (Registry.All.Count == 0)
{
    <MudAlert Severity="Severity.Info">No consoles yet. Add one to start.</MudAlert>
}
else
{
    <MudTable Items="@Registry.All" Hover="true" Dense="true" Elevation="1">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Host</MudTh>
            <MudTh>Source</MudTh>
            <MudTh>Defined by</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Host">@context.Host</MudTd>
            <MudTd DataLabel="Source">
                <MudChip T="string" Size="Size.Small" Color="@(context.Source == ConsoleSource.Configuration ? Color.Default : Color.Info)">
                    @(context.Source == ConsoleSource.Configuration ? "From configuration" : "Added here")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Defined by">@DefinedBy(context)</MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => TestAsync(context))">Test</MudButton>
                @if (context.Source == ConsoleSource.User)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => EditAsync(context))">Edit</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => RemoveAsync(context))">Remove</MudButton>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    protected override void OnInitialized() => Registry.Changed += OnChanged;

    private void OnChanged(ConsoleChange change)
    {
        try
        {
            _ = InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // The circuit ended.
        }
    }

    private static string DefinedBy(ConsoleRuntime console)
    {
        if (console.Source != ConsoleSource.Configuration)
        {
            return "data/consoles.json";
        }

        var config = $"PS5:Consoles:{console.Id}";
        return console.Id.Contains('-')
            ? $"{config} (this id is set in configuration; an environment variable cannot contain a hyphen)"
            : $"{config} · PS5__Consoles__{console.Id}__Host";
    }

    private Task AddAsync() => ConsoleEditor.ShowAsync(Dialogs, null);

    private Task ScanAsync() => NetworkScanDialog.ShowAsync(Dialogs);

    private Task EditAsync(ConsoleRuntime console) => ConsoleActions.EditAsync(Dialogs, Navigation, console);

    private Task TestAsync(ConsoleRuntime console) => ConsoleActions.TestAsync(Dialogs, console);

    private Task RemoveAsync(ConsoleRuntime console) =>
        ConsoleActions.RemoveAsync(Dialogs, Snackbar, Registry, Transfers, console);

    public void Dispose() => Registry.Changed -= OnChanged;
}
