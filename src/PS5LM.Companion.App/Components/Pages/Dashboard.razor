@page "/"
@inherits LiveComponent
@inject ISnackbar Snackbar

<PageTitle>Status</PageTitle>

<MudGrid>
    <MudItem xs="12">
        <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-2">Status<MudText Typo="Typo.subtitle1" Color="Color.Secondary" Inline="true" Class="ml-3">@Target.Name (@Target.Host)</MudText></MudText>
        @if (Status.Message is { Length: > 0 })
        {
            <MudAlert Severity="@(Status.Lifecycle == CompanionLifecycle.Disconnected ? Severity.Error : Severity.Info)" Class="mb-2">
                @Status.Message
            </MudAlert>
        }
        @if (Status.CommandPending)
        {
            <MudAlert Severity="Severity.Warning">
                A load or unload command is waiting on the console. If it is not picked up within a few seconds,
                PS5LM is probably not running.
            </MudAlert>
        }
        @if (ShowManagerWarning)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-2">
                Payload Manager is not reachable@(string.IsNullOrWhiteSpace(Status.PayloadManagerMessage) ? "." : $": {Status.PayloadManagerMessage}")
                The companion cannot see which payloads are installed or launch them. It uses port 8084 on the console unless PS5:PayloadManagerUrl is set.
            </MudAlert>
        }
        else if (MissingRequired.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-2">
                Install @string.Join(", ", MissingRequired.Select(dependency => dependency.Name)) in Payload Manager before starting PS5LM Plus.
                These payloads have to be loaded first.
            </MudAlert>
        }
        @if (!ShowManagerWarning && NotRunningRequired.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-2">
                @string.Join(", ", NotRunningRequired.Select(dependency => dependency.Name)) @(NotRunningRequired.Count == 1 ? "is" : "are") installed but not running.
                Launch @(NotRunningRequired.Count == 1 ? "it" : "them") below before starting PS5LM Plus.
            </MudAlert>
        }
        @if (ElfldrWarning is { } elfldrWarning)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-2">@elfldrWarning</MudAlert>
        }
    </MudItem>

    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-2">Payloads</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                kstuff-lite, etaHEN (or onionHEN) and ShadowMountPlus are checked against Payload Manager's process list.
                When that list cannot be read, Launch recorded only means Payload Manager sent the file.
            </MudText>
            <MudTable Items="Status.Dependencies" Hover="true" Dense="true" T="DependencyStatus">
                <HeaderContent>
                    <MudTh>Payload</MudTh>
                    <MudTh>Need</MudTh>
                    <MudTh>Installed</MudTh>
                    <MudTh>State</MudTh>
                    <MudTh>Detail</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Payload">@context.Name</MudTd>
                    <MudTd DataLabel="Need">@Display.Requirement(context.Requirement)</MudTd>
                    <MudTd DataLabel="Installed">@Display.Presence(context.Presence)</MudTd>
                    <MudTd DataLabel="State">
                        <MudChip T="string" Size="Size.Small" Color="@Display.HealthColor(context.Health)">@Display.Health(context.Health)</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Detail">@context.Message</MudTd>
                    <MudTd>
                        @if (context.CanLaunch)
                        {
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="_launching"
                                       aria-label="@($"Launch {context.Name}")"
                                       OnClick="@(() => LaunchAsync(context))">Launch</MudButton>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-2">Console</MudText>
            <MudSimpleTable Dense="true" Hover="false" Elevation="0">
                <tbody>
                    <tr><td>State</td><td><MudChip T="string" Size="Size.Small" Color="@Display.LifecycleColor(Status.Lifecycle)">@Display.Lifecycle(Status.Lifecycle)</MudChip></td></tr>
                    <tr><td>App</td><td>@(Status.Variant == PS5Variant.Unknown ? "Not detected" : Status.Variant.ToString())</td></tr>
                    <tr><td>Loaded model</td><td>@(Status.LoadedModel ?? "None")</td></tr>
                    <tr><td>Command folder</td><td>@(Status.ControlRoot ?? "Unknown")</td></tr>
                </tbody>
            </MudSimpleTable>
            <MudStack Row="true" Spacing="1" Class="mt-3">
                <MudChip T="string" Size="Size.Small" Color="@Flag(Status.Capabilities.Ftp)">FTP</MudChip>
                <MudChip T="string" Size="Size.Small" Color="@Flag(Status.Capabilities.ModelControl)">Model control</MudChip>
                <MudChip T="string" Size="Size.Small" Color="@Flag(Status.Capabilities.Telemetry)">llama-server</MudChip>
                <MudChip T="string" Size="Size.Small" Color="@Flag(Status.Capabilities.Sensors)">ps5-exporter</MudChip>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-2">Generation</MudText>
            @if (Status.Telemetry is { } telemetry)
            {
                <MudSimpleTable Dense="true" Hover="false" Elevation="0">
                    <tbody>
                        <tr><td>Generation speed</td><td>@telemetry.GenerationTokensPerSecond.ToString("0.0") tokens/s</td></tr>
                        <tr><td>Prompt speed</td><td>@telemetry.PromptTokensPerSecond.ToString("0.0") tokens/s</td></tr>
                        <tr><td>Tokens generated</td><td>@telemetry.TokensGenerated.ToString("N0")</td></tr>
                        <tr><td>Requests in progress</td><td>@telemetry.RequestsProcessing.ToString("0")</td></tr>
                    </tbody>
                </MudSimpleTable>
            }
            else
            {
                <MudText Color="Color.Secondary">Available once a model is loaded and llama-server answers on its port.</MudText>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-2">Sensors</MudText>
            @if (Status.Sensors is { } sensors)
            {
                <MudSimpleTable Dense="true" Hover="false" Elevation="0">
                    <tbody>
                        <tr><td>SoC temperature</td><td>@Value(sensors.SocTemperatureC, "°C")</td></tr>
                        <tr><td>CPU temperature</td><td>@Value(sensors.CpuTemperatureC, "°C")</td></tr>
                        <tr><td>SoC power</td><td>@Value(sensors.SocPowerWatts, "W")</td></tr>
                        <tr><td>Fan duty</td><td>@Value(sensors.FanDuty, "%")</td></tr>
                    </tbody>
                </MudSimpleTable>
            }
            else
            {
                <MudText Color="Color.Secondary">ps5-exporter is not reachable on the console.</MudText>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-2">Storage</MudText>
            @if (Status.Sensors is { Drives.Count: > 0 } storage)
            {
                @foreach (var drive in storage.Drives.Where(d => d.TotalBytes > 0))
                {
                    var used = drive.TotalBytes - drive.FreeBytes;
                    <div class="mb-3">
                        <MudText Typo="Typo.body2">@drive.MountPoint: @Display.Bytes(drive.FreeBytes) free of @Display.Bytes(drive.TotalBytes)</MudText>
                        <MudProgressLinear Value="@(100.0 * used / drive.TotalBytes)" Color="@(used > 0.9 * drive.TotalBytes ? Color.Error : Color.Primary)" />
                    </div>
                }
            }
            else
            {
                <MudText Color="Color.Secondary">Free space is only known when ps5-exporter is running.</MudText>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private bool _launching;

    private bool Checked => Status.UpdatedAt != DateTimeOffset.MinValue;

    private bool ShowManagerWarning => Checked && !Status.PayloadManagerAvailable;

    private IReadOnlyList<DependencyStatus> MissingRequired =>
        Status.Dependencies.Where(dependency => dependency.Requirement == DependencyRequirement.Required && dependency.Presence == DependencyPresence.NotInstalled).ToList();

    private IReadOnlyList<DependencyStatus> NotRunningRequired =>
        Status.Dependencies.Where(dependency => dependency.Requirement == DependencyRequirement.Required && dependency.Health == DependencyHealth.NotRunning).ToList();

    private string? ElfldrWarning =>
        Checked && Status.Dependencies.FirstOrDefault(dependency => dependency.Id == PayloadDependencies.Elfldr) is { Health: not DependencyHealth.Verified } elfldr
            ? elfldr.Message
            : null;

    private async Task LaunchAsync(DependencyStatus dependency)
    {
        if (_launching || !dependency.CanLaunch)
        {
            return;
        }

        _launching = true;
        try
        {
            var result = await Target.Dependencies.LaunchAsync(dependency.Id, CancellationToken.None);
            Snackbar.Add(
                result.Message ?? result.Outcome.ToString(),
                result.Succeeded ? Severity.Success : Severity.Error);
        }
        finally
        {
            _launching = false;
        }
    }

    private static Color Flag(bool on) => on ? Color.Success : Color.Default;

    private static string Value(double? value, string unit) => value is { } v ? $"{v:0.#} {unit}" : "n/a";
}
