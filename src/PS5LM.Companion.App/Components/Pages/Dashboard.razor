@page "/consoles/{ConsoleId}"
@inherits LiveComponent
@using Microsoft.JSInterop
@using PS5LM.Companion.Core.Setup
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject NavigationManager Navigation

<AppPageTitle Page='@(Target is null ? "Console not found" : $"Status - {Target.Name}")' />

@if (Target is null)
{
    <ConsoleNotFound />
}
else
{
<MudGrid>
    <MudItem xs="12">
        <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-2">Status<MudText Typo="Typo.subtitle1" Color="Color.Secondary" Inline="true" Class="ml-3">@Target.Name (@Target.Host)</MudText></MudText>
        @if (Status.Message is { Length: > 0 })
        {
            <MudAlert Severity="@(Status.Lifecycle == CompanionLifecycle.Disconnected ? Severity.Error : Severity.Info)" Class="mb-2">
                @Status.Message
            </MudAlert>
        }
        @if (Status.CommandPending)
        {
            <MudAlert Severity="Severity.Warning">
                A load or unload command is waiting on the console. If it is not picked up within a few seconds,
                PS5LM is probably not running.
            </MudAlert>
        }
        @if (ShowManagerWarning)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-2">
                Payload Manager is not reachable@(string.IsNullOrWhiteSpace(Status.PayloadManagerMessage) ? "." : $": {Status.PayloadManagerMessage}")
                The companion cannot see which payloads are installed or launch them. It uses port 8084 on the console unless PS5:Consoles:@(Target.Id):PayloadManagerUrl is set.
                <div class="mt-2">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@(_restarting || !ElfldrReady)" OnClick="RestartManagerAsync">
                        @(_restarting ? "Restarting Payload Manager..." : "Restart Payload Manager")
                    </MudButton>
                    @if (!ElfldrReady)
                    {
                        <MudText Typo="Typo.caption" Class="ml-2">elfldr is not verified, so a new Payload Manager cannot be started remotely.</MudText>
                    }
                </div>
            </MudAlert>
        }
        else if (MissingRequired.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-2">
                Install @string.Join(", ", MissingRequired.Select(dependency => dependency.Name)) in Payload Manager before starting PS5LM Plus.
                These payloads have to be loaded first.
            </MudAlert>
        }
        @if (!ShowManagerWarning && NotRunningRequired.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-2">
                @string.Join(", ", NotRunningRequired.Select(dependency => dependency.Name)) @(NotRunningRequired.Count == 1 ? "is" : "are") installed but not running.
                Launch @(NotRunningRequired.Count == 1 ? "it" : "them") below before starting PS5LM Plus.
            </MudAlert>
        }
        @if (ElfldrWarning is { } elfldrWarning)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-2">@elfldrWarning</MudAlert>
        }
        @if (VoidShellWarning is { } voidShellWarning)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-2">@voidShellWarning</MudAlert>
        }
        @if (Outdated is { Count: > 0 } outdated)
        {
            <div id="updates" tabindex="-1" class="warning-anchor" @ref="_updatesAnchor">
            <MudAlert Severity="Severity.Warning" Class="mt-2">
                @(outdated.Count == 1 ? "1 component differs" : $"{outdated.Count} components differ") from this companion's pinned versions:
                @string.Join(", ", outdated.Select(update => update.Name)).
                @Display.UpdateCommandGuidance(Target.Host, Target.Options, HasAppUpdate)
                Add <code>--restart</code> to replace a differing stored VoidShell build by stopping and relaunching it, or ShadowMountPlus, which replaces its own running copy when launched again.
                Stored files that already match the pin are skipped; a console reboot can recover a still-running older copy.
            </MudAlert>
            </div>
        }
        @if (SettingsDrift is { Count: > 0 } drift)
        {
            <div id="boot-settings" tabindex="-1" class="warning-anchor" @ref="_settingsAnchor">
            <MudAlert Severity="Severity.Warning" Class="mt-2">
                Boot settings differ from the recommendation. Fix settings only rewrites configuration. It takes effect at the next console boot or autoload and does not restart any payload.
                <ul>
                    @foreach (var item in drift)
                    {
                        <li>@item.Name: @item.Detail</li>
                    }
                </ul>
                @Display.UpdateCommandGuidance(Target.Host, Target.Options, false, true)
                <div class="mt-2">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@(_fixing || Status.Updates?.Checking == true)"
                               OnClick="FixSettingsAsync">
                        @(_fixing ? "Fixing..." : "Fix settings")
                    </MudButton>
                </div>
            </MudAlert>
            </div>
        }
        @if (SettingWarnings is { Count: > 0 } settingWarnings)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-2">
                <ul>
                    @foreach (var warning in settingWarnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </MudAlert>
        }
        @if (Status.Updates?.Failure is { Length: > 0 } failure)
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">
                The last update check or boot-settings change failed: @failure
            </MudAlert>
        }
        @if (Target.Updates is not null)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                <MudText Typo="Typo.caption">@UpdateCheckCaption</MudText>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@(Status.Updates?.Checking == true || _checking)"
                           OnClick="CheckUpdatesAsync">
                    @(_checking || Status.Updates?.Checking == true ? "Checking..." : "Check now")
                </MudButton>
            </MudStack>
        }
        else if (Status.Updates is { Checking: true } || _checking)
        {
            <MudAlert Severity="Severity.Info" Class="mt-2">Checking pinned versions against the console.</MudAlert>
        }
    </MudItem>

    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-2">PS5LM app</MudText>
            @if (Status.AppControl is { Available: true } apps)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                    Checked and launched through @apps.Provider.
                    @apps.Message
                </MudText>
                <MudTable Items="apps.Apps" Hover="true" Dense="true" T="AppVariantStatus">
                    <HeaderContent>
                        <MudTh>App</MudTh>
                        <MudTh>Title ID</MudTh>
                        <MudTh>Installed</MudTh>
                        <MudTh>Version</MudTh>
                        <MudTh>Running</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="App">
                            @context.Name
                            @if (Display.AppUpdateId(context.Variant) is { } appId && Display.UpdateFor(Status, appId) is { } appUpdate)
                            {
                                <MudTooltip Text="@Display.UpdateTooltip(appUpdate)">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-2">Update available</MudChip>
                                </MudTooltip>
                            }
                        </MudTd>
                        <MudTd DataLabel="Title ID">@context.TitleId</MudTd>
                        <MudTd DataLabel="Installed">@(context.Installed ? "Yes" : "No")</MudTd>
                        <MudTd DataLabel="Version">@(context.Variant == Status.Variant ? Status.AppVersion : null)</MudTd>
                        <MudTd DataLabel="Running">
                            <MudChip T="string" Size="Size.Small" Color="@RunColor(context.State)">@RunText(context.State)</MudChip>
                        </MudTd>
                        <MudTd>
                            @if (context.CanLaunch)
                            {
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@(_launchingApp || context.State == AppRunState.Running)"
                                           aria-label="@($"Launch {context.Name}")"
                                           OnClick="@(() => LaunchAppAsync(context))">Launch</MudButton>
                            }
                            @if (context.State == AppRunState.Running)
                            {
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Warning" Class="ml-2" Disabled="_launchingApp"
                                           aria-label="@($"Close {context.Name}")"
                                           OnClick="@(() => CloseAppAsync(context))">Close</MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                <MudText Color="Color.Secondary">
                    @(Checked ? Status.AppControl?.Message : "Waiting for the first status check.")
                    The pinned nefarius VoidShell fork is required.
                </MudText>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-2">Payloads</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                The pinned nefarius VoidShell fork is required and is checked on its own port. Its API version does not identify the release.
                kstuff-lite, etaHEN (or onionHEN) and ShadowMountPlus are checked against Payload Manager's process list.
                When that list cannot be read, Launch recorded only means Payload Manager sent the file.
            </MudText>
            <MudTable Items="Status.Dependencies" Hover="true" Dense="true" T="DependencyStatus">
                <HeaderContent>
                    <MudTh>Payload</MudTh>
                    <MudTh>Need</MudTh>
                    <MudTh>Installed</MudTh>
                    <MudTh>State</MudTh>
                    <MudTh>Detail</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Payload">
                        @context.Name
                        @if (Display.UpdateFor(Status, context.Id) is { } payloadUpdate)
                        {
                            <MudTooltip Text="@Display.UpdateTooltip(payloadUpdate)">
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-2">Update available</MudChip>
                            </MudTooltip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Need">@Display.Requirement(context.Requirement)</MudTd>
                    <MudTd DataLabel="Installed">@Display.Presence(context.Presence)</MudTd>
                    <MudTd DataLabel="State">
                        <MudChip T="string" Size="Size.Small" Color="@Display.HealthColor(context.Health)">@Display.Health(context.Health)</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Detail">@context.Message</MudTd>
                    <MudTd>
                        @if (context.CanLaunch)
                        {
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="_launching"
                                       aria-label="@($"Launch {context.Name}")"
                                       OnClick="@(() => LaunchAsync(context))">Launch</MudButton>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-2">Console</MudText>
            <MudSimpleTable Dense="true" Hover="false" Elevation="0">
                <tbody>
                    <tr><td>State</td><td><MudChip T="string" Size="Size.Small" Color="@Display.LifecycleColor(Status.Lifecycle)">@Display.Lifecycle(Status.Lifecycle)</MudChip></td></tr>
                    <tr><td>App</td><td>@Display.AppText(Status)</td></tr>
                    <tr><td>Firmware</td><td>@(Status.FirmwareVersion ?? "n/a")</td></tr>
                    <tr><td>Loaded model</td><td>@(Status.LoadedModel ?? "None")</td></tr>
                    <tr><td>Command folder</td><td>@(Status.ControlRoot ?? "Unknown")</td></tr>
                </tbody>
            </MudSimpleTable>
            <MudStack Row="true" Spacing="1" Class="mt-3">
                <MudChip T="string" Size="Size.Small" Color="@Flag(Status.Capabilities.Ftp)">FTP</MudChip>
                <MudChip T="string" Size="Size.Small" Color="@Flag(Status.Capabilities.ModelControl)">Model control</MudChip>
                <MudChip T="string" Size="Size.Small" Color="@Flag(Status.Capabilities.Telemetry)">llama-server</MudChip>
                <MudChip T="string" Size="Size.Small" Color="@Flag(Status.Capabilities.Sensors)">ps5-exporter</MudChip>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-2">Generation</MudText>
            @if (Status.Telemetry is { } telemetry)
            {
                <MudSimpleTable Dense="true" Hover="false" Elevation="0">
                    <tbody>
                        <tr><td>Generation speed</td><td>@telemetry.GenerationTokensPerSecond.ToString("0.0") tokens/s</td></tr>
                        <tr><td>Prompt speed</td><td>@telemetry.PromptTokensPerSecond.ToString("0.0") tokens/s</td></tr>
                        <tr><td>Tokens generated</td><td>@telemetry.TokensGenerated.ToString("N0")</td></tr>
                        <tr><td>Requests in progress</td><td>@telemetry.RequestsProcessing.ToString("0")</td></tr>
                    </tbody>
                </MudSimpleTable>
            }
            else
            {
                <MudText Color="Color.Secondary">Available once a model is loaded and llama-server answers on its port.</MudText>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-2">Sensors</MudText>
            @if (Status.Sensors is { } sensors)
            {
                <MudSimpleTable Dense="true" Hover="false" Elevation="0">
                    <tbody>
                        <tr><td>SoC temperature</td><td>@Value(sensors.SocTemperatureC, "°C")</td></tr>
                        <tr><td>CPU temperature</td><td>@Value(sensors.CpuTemperatureC, "°C")</td></tr>
                        <tr><td>SoC power</td><td>@Value(sensors.SocPowerWatts, "W")</td></tr>
                        <tr><td>Fan duty</td><td>@Value(sensors.FanDuty, "%")</td></tr>
                    </tbody>
                </MudSimpleTable>
            }
            else
            {
                <MudText Color="Color.Secondary">ps5-exporter is not reachable on the console.</MudText>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-2">Storage</MudText>
            @if (Status.Sensors is { Drives.Count: > 0 } storage)
            {
                @foreach (var drive in storage.Drives.Where(d => d.TotalBytes > 0))
                {
                    var used = drive.TotalBytes - drive.FreeBytes;
                    <div class="mb-3">
                        <MudText Typo="Typo.body2">@drive.MountPoint: @Display.Bytes(drive.FreeBytes) free of @Display.Bytes(drive.TotalBytes)</MudText>
                        <MudProgressLinear Value="@(100.0 * used / drive.TotalBytes)" Color="@(used > 0.9 * drive.TotalBytes ? Color.Error : Color.Primary)" />
                    </div>
                }
            }
            else
            {
                <MudText Color="Color.Secondary">Free space is only known when ps5-exporter is running.</MudText>
            }
        </MudPaper>
    </MudItem>
</MudGrid>
}

@code {
    private bool _launching;
    private bool _launchingApp;
    private bool _restarting;
    private bool _checking;
    private bool _fixing;
    private ElementReference _updatesAnchor;
    private ElementReference _settingsAnchor;
    private string? _focusedFragment;

    /// <summary>
    /// A warning link on the overview card ends in #boot-settings or #updates. The browser scrolls there, but the
    /// section only exists once the status has loaded, and the router focuses the heading otherwise, so focus it here.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var fragment = Navigation.ToAbsoluteUri(Navigation.Uri).Fragment;
        if (fragment is not ("#boot-settings" or "#updates"))
        {
            _focusedFragment = null;
            return;
        }

        var anchor = fragment == "#updates" ? _updatesAnchor : _settingsAnchor;
        if (_focusedFragment == fragment || anchor.Context is null)
        {
            return;
        }

        _focusedFragment = fragment;
        try
        {
            await anchor.FocusAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // The circuit ended or the section went away; the link still scrolled to it.
        }
    }

    private static string RunText(AppRunState state) => state switch
    {
        AppRunState.Running => "Running",
        AppRunState.NotRunning => "Not running",
        AppRunState.RunningVariantUnknown => "A PS5LM app is running",
        _ => "Unknown",
    };

    private static Color RunColor(AppRunState state) => state switch
    {
        AppRunState.Running => Color.Success,
        AppRunState.RunningVariantUnknown => Color.Warning,
        _ => Color.Default,
    };

    protected override Task OnConsoleChangedAsync()
    {
        _launching = false;
        _launchingApp = false;
        _restarting = false;
        _checking = false;
        _fixing = false;
        return Task.CompletedTask;
    }

    private bool ElfldrReady =>
        Status.Dependencies.FirstOrDefault(dependency => dependency.Id == PayloadDependencies.Elfldr) is { Health: DependencyHealth.Verified };

    private async Task RestartManagerAsync()
    {
        var console = Target;
        if (console is null || _restarting)
        {
            return;
        }

        _restarting = true;
        try
        {
            if (!await Confirm.AskAsync(Dialogs, $"Restart Payload Manager on {console.Name}",
                    $"Stop Payload Manager on {Confirm.On(console)} and start a fresh copy? Running payloads are not affected.", "Restart")
                || !ReferenceEquals(console, Target))
            {
                return;
            }

            var result = await console.ManagerRestart.RestartAsync(CancellationToken.None);
            Snackbar.Add(result.Message ?? result.Outcome.ToString(), result.Succeeded ? Severity.Success : Severity.Error);
        }
        finally
        {
            _restarting = false;
        }
    }

    private async Task CloseAppAsync(AppVariantStatus app)
    {
        var console = Target;
        if (console is null || _launchingApp)
        {
            return;
        }

        _launchingApp = true;
        try
        {
            if (!await Confirm.AskAsync(Dialogs, $"Close {app.Name} on {console.Name}",
                    $"Close {app.Name} on {Confirm.On(console)}? The console returns to the home screen.", "Close")
                || !ReferenceEquals(console, Target))
            {
                return;
            }

            var result = await console.Closer.CloseAsync(app.Variant, CancellationToken.None);
            Snackbar.Add(result.Message ?? result.Outcome.ToString(), result.Succeeded ? Severity.Success : Severity.Error);
        }
        finally
        {
            _launchingApp = false;
        }
    }

    private async Task LaunchAppAsync(AppVariantStatus app)
    {
        var console = Target;
        if (console is null || _launchingApp || !app.CanLaunch || app.State == AppRunState.Running)
        {
            return;
        }

        _launchingApp = true;
        try
        {
            if (!await Confirm.AskAsync(Dialogs, $"Launch {app.Name} on {console.Name}",
                    $"Launch {app.Name} on {Confirm.On(console)}?", "Launch")
                || !ReferenceEquals(console, Target))
            {
                return;
            }

            var result = await console.Apps.LaunchAsync(app.Variant, CancellationToken.None);
            Snackbar.Add(result.Message ?? result.Outcome.ToString(), result.Succeeded ? Severity.Success : Severity.Error);
        }
        finally
        {
            _launchingApp = false;
        }
    }

    private bool Checked => Status.UpdatedAt != DateTimeOffset.MinValue;

    private bool ShowManagerWarning => Checked && !Status.PayloadManagerAvailable;

    private IReadOnlyList<DependencyStatus> MissingRequired =>
        Status.Dependencies.Where(dependency => dependency.Requirement == DependencyRequirement.Required && dependency.Presence == DependencyPresence.NotInstalled).ToList();

    private IReadOnlyList<DependencyStatus> NotRunningRequired =>
        Status.Dependencies.Where(dependency => dependency.Requirement == DependencyRequirement.Required && dependency.Health == DependencyHealth.NotRunning).ToList();

    private string? ElfldrWarning =>
        Checked && Status.Dependencies.FirstOrDefault(dependency => dependency.Id == PayloadDependencies.Elfldr) is { Health: not DependencyHealth.Verified } elfldr
            ? elfldr.Message
            : null;

    private string? VoidShellWarning =>
        Checked && Status.Dependencies.FirstOrDefault(dependency => dependency.Id == PayloadDependencies.VoidShell) is { Health: DependencyHealth.Unknown } voidShell
            ? voidShell.Message
            : null;

    private IReadOnlyList<ComponentUpdate> Outdated => Status.Updates?.Outdated ?? [];

    private IReadOnlyList<SettingDrift> SettingsDrift => Status.Updates?.Settings ?? [];

    private IReadOnlyList<string> SettingWarnings => Status.Updates?.Warnings ?? [];

    private bool HasAppUpdate => Outdated.Any(update => ComponentUpdates.AppId(PS5Variant.PS5LM) == update.Id || ComponentUpdates.AppId(PS5Variant.PS5LMPlus) == update.Id);

    private string UpdateCheckCaption =>
        Status.Updates is { Checking: true } || _checking
            ? "Checking..."
            : Status.Updates?.HashCheckedAt is { } at
                ? $"Last checked {at.ToLocalTime():g}."
                : "Waiting for the first file check.";

    private async Task CheckUpdatesAsync()
    {
        var console = Target;
        if (console?.Updates is null || _checking)
        {
            return;
        }

        _checking = true;
        try
        {
            await console.Updates.CheckAsync(CancellationToken.None);
        }
        finally
        {
            _checking = false;
        }
    }

    private async Task FixSettingsAsync()
    {
        var console = Target;
        if (console?.Updates is null || _fixing)
        {
            return;
        }

        if (BootSettings.IsBusy(console.Store.Current, Transfers.HasActive(console.Id)))
        {
            Snackbar.Add(BootSettings.BusyMessage, Severity.Warning);
            return;
        }

        _fixing = true;
        try
        {
            if (!await Confirm.AskAsync(Dialogs, $"Fix boot settings on {console.Name}",
                    $"Rewrite the autoload list, countdown and OnionHEN bundled-kstuff switch on {Confirm.On(console)}? This only changes configuration. It takes effect at the next boot or autoload and does not restart any payload.",
                    "Fix settings")
                || !ReferenceEquals(console, Target))
            {
                return;
            }

            if (BootSettings.IsBusy(console.Store.Current, Transfers.HasActive(console.Id)))
            {
                Snackbar.Add(BootSettings.BusyMessage, Severity.Warning);
                return;
            }

            var status = await console.Updates.ApplySettingsAsync(CancellationToken.None);
            if (status.Failure is { Length: > 0 } failure)
            {
                Snackbar.Add(failure, Severity.Error);
            }
            else if (status.Warnings.Count > 0)
            {
                Snackbar.Add(string.Join(" ", status.Warnings), Severity.Warning);
            }
            else if (status.Settings.Count > 0)
            {
                Snackbar.Add("Some boot settings still differ from the recommendation.", Severity.Warning);
            }
            else
            {
                Snackbar.Add("Boot settings were updated. They take effect at the next boot or autoload.", Severity.Success);
            }
        }
        finally
        {
            _fixing = false;
        }
    }

    private async Task LaunchAsync(DependencyStatus dependency)
    {
        var console = Target;
        if (console is null || _launching || !dependency.CanLaunch)
        {
            return;
        }

        _launching = true;
        try
        {
            if (!await Confirm.AskAsync(Dialogs, $"Launch {dependency.Name} on {console.Name}",
                    $"Launch {dependency.Name} on {Confirm.On(console)}?", "Launch")
                || !ReferenceEquals(console, Target))
            {
                return;
            }

            var result = await console.Dependencies.LaunchAsync(dependency.Id, CancellationToken.None);
            Snackbar.Add(
                result.Message ?? result.Outcome.ToString(),
                result.Succeeded ? Severity.Success : Severity.Error);
        }
        finally
        {
            _launching = false;
        }
    }

    private static Color Flag(bool on) => on ? Color.Success : Color.Default;

    private static string Value(double? value, string unit) => value is { } v ? $"{v:0.#} {unit}" : "n/a";
}
