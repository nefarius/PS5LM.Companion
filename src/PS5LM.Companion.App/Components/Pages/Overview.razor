@page "/"
@inject IConsoleRegistry Registry
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@implements IDisposable

<PageTitle>Overview</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-2">Overview</MudText>

@if (Registry.All.Count == 0)
{
    <MudPaper Class="pa-6" Elevation="0">
        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-1">Add your first console</MudText>
        <MudText Class="mb-4">The companion needs the address of a console running PS5LM or PS5LM Plus.</MudText>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Outlined" Disabled="true">Scan network</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddAsync">Add manually</MudButton>
        </MudStack>
        <MudText Typo="Typo.caption" Class="mt-2">Network scanning is not available yet.</MudText>
    </MudPaper>
}
else
{
    <MudStack Row="true" Spacing="1" Class="mb-4" aria-label="Fleet summary">
        <MudChip T="string" Size="Size.Small">@Registry.All.Count consoles</MudChip>
        <MudChip T="string" Size="Size.Small" Color="Color.Success">@_ready ready</MudChip>
        <MudChip T="string" Size="Size.Small" Color="Color.Primary">@_generating generating</MudChip>
        <MudChip T="string" Size="Size.Small" Color="Color.Error">@_offline offline</MudChip>
    </MudStack>
    <MudGrid>
        @foreach (var console in Registry.All)
        {
            <MudItem xs="12" md="6" lg="4">
                <ConsoleCard Console="@console" />
            </MudItem>
        }
    </MudGrid>
}

@code {
    private int _ready;
    private int _generating;
    private int _offline;

    protected override void OnInitialized()
    {
        if (Registry.All.Count == 1)
        {
            Navigation.NavigateTo($"consoles/{Registry.All[0].Id}");
            return;
        }

        foreach (var console in Registry.All)
        {
            console.Store.Changed += OnStatusChanged;
        }

        Registry.Changed += OnRegistryChanged;
        Recount();
    }

    private void OnRegistryChanged(ConsoleChange change)
    {
        if (change.Previous is { } previous)
        {
            previous.Store.Changed -= OnStatusChanged;
        }

        if (change.Current is { } current)
        {
            current.Store.Changed += OnStatusChanged;
        }

        try
        {
            _ = InvokeAsync(() =>
            {
                Recount();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // The circuit ended.
        }
    }

    private void OnStatusChanged(CompanionStatus status)
    {
        try
        {
            _ = InvokeAsync(() =>
            {
                Recount();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // The circuit ended.
        }
    }

    private Task AddAsync() => ConsoleEditor.ShowAsync(Dialogs, null);

    private void Recount()
    {
        _ready = 0;
        _generating = 0;
        _offline = 0;
        foreach (var lifecycle in Registry.All.Select(console => console.Store.Current.Lifecycle))
        {
            switch (lifecycle)
            {
                case CompanionLifecycle.Ready:
                    _ready++;
                    break;
                case CompanionLifecycle.Generating:
                    _generating++;
                    break;
                case CompanionLifecycle.Disconnected:
                    _offline++;
                    break;
            }
        }
    }

    public void Dispose()
    {
        Registry.Changed -= OnRegistryChanged;
        foreach (var console in Registry.All)
        {
            console.Store.Changed -= OnStatusChanged;
        }
    }
}
