@inject IConsoleDiscovery Discovery

<MudDialog>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
            A container on a bridge network only sees its own subnet. Run the companion with network_mode: host, or enter the LAN CIDR.
        </MudAlert>
        <MudTextField @bind-Value="_cidr" Label="CIDR" HelperText="Empty scans the networks of the up interfaces, at most a /22." Class="mb-3" />
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
        }
        @if (_scanned && _results.Count == 0 && _error is null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">No consoles found.</MudAlert>
        }
        <MudList T="DiscoveredConsole" SelectedValueChanged="Pick">
            @foreach (var console in _results)
            {
                <MudListItem T="DiscoveredConsole" Value="@console">
                    @console.Host — @(console.Ps5LmPlus ? "PS5LM Plus" : "PS5LM")
                    @if (console.PayloadManager) { <span> · Payload Manager</span> }
                    @if (console.VoidShell) { <span> · VoidShell</span> }
                    @if (console.Exporter) { <span> · ps5-exporter</span> }
                </MudListItem>
            }
        </MudList>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ScanAsync" Disabled="_busy">Scan</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly List<DiscoveredConsole> _results = [];
    private string? _cidr;
    private string? _error;
    private bool _busy;
    private bool _scanned;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    public static async Task<string?> ShowAsync(IDialogService dialogs)
    {
        var dialog = await dialogs.ShowAsync<NetworkScanDialog>(
            "Scan network",
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        return result is { Canceled: false, Data: string host } ? host : null;
    }

    private async Task ScanAsync()
    {
        _busy = true;
        _error = null;
        _results.Clear();
        try
        {
            _results.AddRange(await Discovery.ScanAsync(string.IsNullOrWhiteSpace(_cidr) ? null : _cidr.Trim(), CancellationToken.None));
            _scanned = true;
        }
        catch (FormatException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void Pick(DiscoveredConsole console) => MudDialog.Close(DialogResult.Ok(console.Host));

    private void Cancel() => MudDialog.Cancel();
}
