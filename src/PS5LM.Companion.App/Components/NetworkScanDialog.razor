@implements IDisposable
@inject IConsoleDiscovery Discovery
@inject IConsoleRegistry Registry
@inject IDialogService Dialogs

<MudDialog>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
            A container on a bridge network only sees its own subnet. Run the companion with network_mode: host, or enter the LAN CIDR.
        </MudAlert>
        <MudTextField @bind-Value="_cidr" Label="CIDR" HelperText="Empty scans the networks of the up interfaces, at most a /22." Class="mb-3" />
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
        }
        @if (_scanned && _results.Count == 0 && _error is null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">No consoles found.</MudAlert>
        }
        @foreach (var console in _results)
        {
            var added = IsConfigured(console);
            <MudPaper Outlined="true" Class="pa-3 mb-2" Style="@(added ? "opacity: 0.6" : null)">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Baseline">
                    <MudText Typo="Typo.body1">@(console.HostName ?? console.Host)</MudText>
                    @if (console.HostName is not null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@console.Host</MudText>
                    }
                </MudStack>
                <MudText Typo="Typo.body2" Class="mt-1">
                    @Describe(console)
                    @if (console.PayloadManager) { <span> · Payload Manager</span> }
                    @if (console.VoidShell) { <span> · VoidShell</span> }
                    @if (console.Exporter) { <span> · ps5-exporter</span> }
                </MudText>
                @if (!console.Ftp)
                {
                    <MudText Typo="Typo.caption" Class="d-block">found via VoidShell (FTP unavailable)</MudText>
                }
                @if (console.VoidShell && !console.VoidShellFork)
                {
                    <MudText Typo="Typo.caption" Class="d-block">not the nefarius fork</MudText>
                }
                @if (added)
                {
                    <MudChip T="string" Size="Size.Small" Class="mt-2">Already added</MudChip>
                }
                else if (console.HostName is not null)
                {
                    <MudStack Row="true" Spacing="1" Class="mt-2">
                        <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => UseHostName(console))">Use hostname</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => Pick(console.Host))">Use IP</MudButton>
                    </MudStack>
                }
                else
                {
                    <MudStack Row="true" Spacing="1" Class="mt-2">
                        <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => Pick(console.Host))">Use IP</MudButton>
                    </MudStack>
                }
            </MudPaper>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ScanAsync" Disabled="_busy">Scan</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly List<DiscoveredConsole> _results = [];
    private readonly CancellationTokenSource _cancel = new();
    private string? _cidr;
    private string? _error;
    private bool _busy;
    private bool _scanned;
    private bool _disposed;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    public static async Task ShowAsync(IDialogService dialogs)
    {
        var dialog = await dialogs.ShowAsync<NetworkScanDialog>(
            "Scan network",
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        await dialog.Result;
    }

    private static string Describe(DiscoveredConsole console)
    {
        if (console.Ps5Lm && console.Ps5LmPlus)
        {
            return "PS5LM and PS5LM Plus";
        }

        if (console.Ps5LmPlus)
        {
            return "PS5LM Plus";
        }

        if (console.Ps5Lm)
        {
            return "PS5LM";
        }

        return "no PS5LM app installed";
    }

    private async Task ScanAsync()
    {
        _busy = true;
        _error = null;
        _results.Clear();
        try
        {
            _results.AddRange(await Discovery.ScanAsync(string.IsNullOrWhiteSpace(_cidr) ? null : _cidr.Trim(), _cancel.Token));
            _scanned = true;
        }
        catch (FormatException ex)
        {
            _error = ex.Message;
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            _busy = false;
        }
    }

    private bool IsConfigured(DiscoveredConsole console) =>
        Registry.All.Any(existing => SameHost(existing.Host, console.Host) || SameHost(existing.Host, console.HostName));

    private static bool SameHost(string configured, string? found) =>
        !string.IsNullOrWhiteSpace(found)
        && string.Equals(configured.Trim(), found.Trim(), StringComparison.OrdinalIgnoreCase);

    private Task UseHostName(DiscoveredConsole console) =>
        console.HostName is { } name ? Pick(name) : Task.CompletedTask;

    private async Task Pick(string host)
    {
        await ConsoleEditor.ShowAsync(Dialogs, null, host);
        if (!_disposed)
        {
            StateHasChanged();
        }
    }

    private void Close()
    {
        _cancel.Cancel();
        MudDialog.Cancel();
    }

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        _cancel.Cancel();
        _cancel.Dispose();
    }
}
